# ============================================================
# 铸语 PromptForge 环境变量配置
# 复制为 .env 后按需修改：cp .env.example .env
# JWT_SECRET / ENCRYPT_KEY 示例值仅供参考，正式部署请自行重新生成：
#   openssl rand -hex 32
# ============================================================

# ---------- 数据库（PostgreSQL 15） ----------
DB_NAME=chengrongjieyue
DB_USER=chengrongjieyue
DB_PASSWORD=Crjy@Pg2026

# ---------- 安全密钥（必填，禁止使用示例值上线） ----------
# JWT 签名密钥，长度至少 32 字符
JWT_SECRET=1ef0b2c7f46fc4158ad5f2a432e4d1c7a7e3758a05838c12c7f371e4c9fe219f
# DeepSeek API Key 的 AES-256 加密密钥，用于加解密后台保存的 Key
ENCRYPT_KEY=ee9335ed668d87615ef4f796cb3b7f29b0c2d8e03a78cf86bbd8fe1e33ec3cea

# ---------- 初始管理员（首次启动自动创建，登录后请立即改密） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ---------- 入口端口 ----------
NGINX_PORT=80
